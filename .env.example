LUDISKUS_API_PORT=8096
LUDISKUS_HTTP_ADDR=:8080

LUDISKUS_DB_USER=ludiskus
LUDISKUS_DB_PASSWORD=ludiskus
LUDISKUS_DB_NAME=ludiskus
LUDISKUS_DB_EXPOSE_PORT=5441
LUDISKUS_DB_MAX_CONNS=10

LUDISKUS_REDIS_URL=redis://redis:6379/6

HIPCORE_URL=http://host.docker.internal:8081
HIPCORE_JWKS_URL=
HIPCORE_AUDIENCE=

GATEWAY_SIGNING_SECRET=change-me

LUDISKUS_HIPCORE_CLIENT_ID=
LUDISKUS_HIPCORE_CLIENT_SECRET=

LUNOTI_API_URL=http://host.docker.internal:8092

LUDISKUS_LUNOTI_CLIENT_ID=
LUDISKUS_LUNOTI_CLIENT_SECRET=

LUDISKUS_S3_ENDPOINT=https://storage.example.com
LUDISKUS_S3_PUBLIC_ENDPOINT=https://storage.example.com
LUDISKUS_S3_ACCESS_KEY=minio
LUDISKUS_S3_SECRET_KEY=minio12345
LUDISKUS_S3_BUCKET=ludiskus-attachments

LUDISKUS_MAX_FILE_MB=25
LUDISKUS_PRESIGN_TTL=5m
LUDISKUS_MAX_ATTACHMENTS=10
LUDISKUS_ALLOWED_MIME=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,application/zip
LUDISKUS_CACHE_TTL=1h
LUDISKUS_PROFILE_SYNC_INTERVAL=6h
LUDISKUS_SPACE_SYNC_INTERVAL=6h
LUDISKUS_ATTACH_TTL=24h
LUDISKUS_REACTION_DEBOUNCE=5m
LUDISKUS_OUTBOX_MAX_ATTEMPTS=6
LUDISKUS_LOG_LEVEL=info
