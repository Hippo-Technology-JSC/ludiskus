{
  "event_types": [
    { "code": "ludiskus.topic.replied",      "name": "Có trả lời mới",          "category": "discussion", "default_channels": ["web"] },
    { "code": "ludiskus.post.mentioned",     "name": "Bạn được nhắc đến",       "category": "discussion", "default_channels": ["web", "email"] },
    { "code": "ludiskus.topic.answered",     "name": "Câu hỏi đã có trả lời",   "category": "discussion", "default_channels": ["web", "email"] },
    { "code": "ludiskus.moderation.pending", "name": "Có bài chờ duyệt",        "category": "moderation", "default_channels": ["web"] },
    { "code": "ludiskus.moderation.decided", "name": "Bài đã được xử lý",       "category": "moderation", "default_channels": ["web", "email"] }
  ],
  "templates": [
    { "code": "ludiskus.topic.replied",  "name": "Trả lời mới",  "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Trả lời mới trong \"{{topic}}\"", "body": "{{actor}} đã trả lời chủ đề bạn theo dõi", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.post.mentioned", "name": "Được nhắc đến", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "{{actor}} đã nhắc đến bạn", "body": "Trong \"{{topic}}\": {{excerpt}}", "action_url": "{{url}}" },
                          "email": { "subject": "[{{space}}] {{actor}} đã nhắc đến bạn", "body": "<p>{{actor}} đã nhắc đến bạn trong <b>{{topic}}</b>.</p>" } } } },
    { "code": "ludiskus.topic.answered", "name": "Đã có trả lời", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Câu hỏi của bạn đã có câu trả lời", "body": "Trong \"{{topic}}\"", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.moderation.pending", "name": "Chờ duyệt", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Có bài chờ duyệt", "body": "Trong cộng đồng {{space}}", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.moderation.decided", "name": "Đã xử lý", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Bài của bạn đã được {{decision}}", "body": "{{note}}", "action_url": "{{url}}" } } } }
  ]
}
