{
  "event_types": [
    { "code": "ludiskus.topic.replied",      "name": "Có trả lời mới",          "category": "discussion", "default_channels": ["web"] },
    { "code": "ludiskus.post.mentioned",     "name": "Bạn được nhắc đến",       "category": "discussion", "default_channels": ["web", "email"] },
    { "code": "ludiskus.topic.answered",     "name": "Câu hỏi đã có trả lời",   "category": "discussion", "default_channels": ["web", "email"] },
    { "code": "ludiskus.moderation.pending", "name": "Có bài chờ duyệt",        "category": "moderation", "default_channels": ["web"] },
    { "code": "ludiskus.moderation.decided", "name": "Bài đã được xử lý",       "category": "moderation", "default_channels": ["web", "email"] },
    { "code": "ludiskus.comment.created",    "name": "Có bình luận mới",       "category": "discussion", "default_channels": ["web"] },
    { "code": "ludiskus.comment.replied",    "name": "Có trả lời bình luận",   "category": "discussion", "default_channels": ["web"] },
    { "code": "ludiskus.comment.mentioned",  "name": "Được nhắc trong bình luận", "category": "discussion", "default_channels": ["web", "email"] },
    { "code": "ludiskus.comment.pending",    "name": "Bình luận chờ duyệt",    "category": "moderation", "default_channels": ["web"] },
    { "code": "ludiskus.comment.moderated",  "name": "Bình luận đã được xử lý", "category": "moderation", "default_channels": ["web", "email"] },
    {"code": "ludiskus.poll.closed", "name": "Bình chọn đã kết thúc", "category": "poll", "default_channels": ["web"]},
    {"code": "ludiskus.poll.closing_soon", "name": "Bình chọn sắp kết thúc", "category": "poll", "default_channels": ["web"]},
    {"code": "ludiskus.poll.invited", "name": "Bạn được mời bỏ phiếu", "category": "poll", "default_channels": ["web"]},
    {"code": "ludiskus.poll.option_pending", "name": "Lựa chọn bình chọn chờ duyệt", "category": "moderation", "default_channels": ["web"]},
    {"code": "ludiskus.poll.moderated", "name": "Bình chọn đã được xử lý", "category": "moderation", "default_channels": ["web"]}
  ],
  "templates": [
    { "code": "ludiskus.topic.replied",  "name": "Trả lời mới",  "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Trả lời mới trong \"{{topic}}\"", "body": "{{actor}} đã trả lời chủ đề bạn theo dõi", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.post.mentioned", "name": "Được nhắc đến trong bài đăng Ludiskus", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "{{actor}} đã nhắc đến bạn trong bài đăng trên Ludiskus", "body": "Trong chủ đề \"{{topic}}\" của cộng đồng {{space}}: {{excerpt}}", "action_url": "{{url}}" },
                          "email": { "subject": "[Ludiskus · {{space}}] {{actor}} đã nhắc đến bạn", "body": "<p>{{actor}} đã nhắc đến bạn trong bài đăng thuộc chủ đề <b>{{topic}}</b> trên Ludiskus.</p>" } } } },
    { "code": "ludiskus.topic.answered", "name": "Đã có trả lời", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Câu hỏi của bạn đã có câu trả lời", "body": "Trong \"{{topic}}\"", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.moderation.pending", "name": "Chờ duyệt", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Có bài chờ duyệt", "body": "Trong cộng đồng {{space}}", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.moderation.decided", "name": "Đã xử lý", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Bài của bạn đã được {{decision}}", "body": "{{note}}", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.comment.created", "name": "Bình luận mới", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "{{actor}} đã bình luận về ‘{{resourceTitle}}’", "body": "{{excerpt}}", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.comment.replied", "name": "Trả lời bình luận", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Có trả lời mới trong ‘{{resourceTitle}}’", "body": "{{actor}} và {{others}} người khác đã trả lời", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.comment.mentioned", "name": "Nhắc đến trong bình luận", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "{{actor}} đã nhắc đến bạn", "body": "{{excerpt}}", "action_url": "{{url}}" },
                          "email": { "subject": "{{actor}} đã nhắc đến bạn", "body": "<p>{{excerpt}}</p>" } } } },
    { "code": "ludiskus.comment.pending", "name": "Bình luận chờ duyệt", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "{{count}} bình luận chờ duyệt", "body": "Trong {{spaceName}}", "action_url": "{{url}}" } } } },
    { "code": "ludiskus.comment.moderated", "name": "Bình luận đã xử lý", "locale_default": "vi",
      "bodies": { "vi": { "web": { "title": "Bình luận của bạn đã bị {{decision}}", "body": "{{note}}", "action_url": "{{url}}" },
                          "email": { "subject": "Bình luận của bạn đã được xử lý", "body": "<p>{{note}}</p>" } } } },
    {"code": "ludiskus.poll.closed", "name": "Bình chọn đã kết thúc", "locale_default": "vi", "bodies": {"vi": {"web": {"title": "Bình chọn đã kết thúc", "body": "{{question}}", "action_url": "{{actionUrl}}"}}}},
    {"code": "ludiskus.poll.closing_soon", "name": "Bình chọn sắp kết thúc", "locale_default": "vi", "bodies": {"vi": {"web": {"title": "Bình chọn sắp kết thúc", "body": "{{question}}", "action_url": "{{actionUrl}}"}}}},
    {"code": "ludiskus.poll.invited", "name": "Bạn được mời bỏ phiếu", "locale_default": "vi", "bodies": {"vi": {"web": {"title": "Bạn được mời bỏ phiếu", "body": "{{question}}", "action_url": "{{actionUrl}}"}}}},
    {"code": "ludiskus.poll.option_pending", "name": "Lựa chọn bình chọn chờ duyệt", "locale_default": "vi", "bodies": {"vi": {"web": {"title": "Lựa chọn bình chọn chờ duyệt", "body": "{{question}}", "action_url": "{{actionUrl}}"}}}},
    {"code": "ludiskus.poll.moderated", "name": "Bình chọn đã được xử lý", "locale_default": "vi", "bodies": {"vi": {"web": {"title": "Bình chọn đã được xử lý", "body": "{{question}}", "action_url": "{{actionUrl}}"}}}}
  ]
}
